    public Character(string name, int x. int y,int width, int height, int health)
}
    {
        Name =name;
        X = x;
        Y = y;
        Width = width;
        Height = height;
        Health = health;

    }
 //Beahvior: mehtods define what the character can Do public void MoveTo(int newX, int newY)
{
